# пример конфигуарции

# API
APP_NAME=AI RAG Service
APP_VERSION=1.0.0
DEBUG=True

# JWT
JWT_SECRET_KEY=dev-secret-key-2026
JWT_ALGORITHM=HS256

# ===== QDRANT (вектора) =====
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=knowledge
QDRANT_VECTOR_SIZE=768
QDRANT_DISTANCE=Cosine


# ===== MINIO (файлы) =====
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET=knowledge-bucket
MINIO_SECURE=False

# ===== REDIS (кэш) =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ===== DEEPSEEK (LLM) =====
DEEPSEEK_API_KEY=sk-ваш_ключ_здесь 
DEEPSEEK_MODEL=deepseek-chat

# ===== EMBEDDING MODEL =====
EMBEDDING_MODEL=sergeyzh/LaBSE-ru-sts